  "id": "ady-Cyrl-alphabet",
  "title": "Adyghe (ady) Cyrillic Alphabet",
  "description": "The letters of the Adyghe Cyrillic alphabet in alphabetical order with their lower-, title- and upper-case forms, together with the auxiliary letters used for dialectal sounds that are not part of the official alphabet. Intended as the source object for collation, validation, keyboard work and for the transliteration and IPA tables derived from it.",
  "version": "1.0.0",
  "updated": "2026-09-15",
  "status": "stable",
  "language": "ady",
  "script": "Cyrl",
  "documentation": "./ady-Cyrl-alphabet.md",
