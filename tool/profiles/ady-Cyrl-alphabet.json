  "cite_as": "Nemlioğlu, M. U. (2026). Adyghe (ady) Cyrillic Alphabet (Version 1.0.0) [Data set]. ady-kbd-language-resources. https://github.com/nemerko/ady-kbd-language-resources",
  "unicode_normalisation": "NFC",
  "exemplar_main": "а б в г {гу} {гъ} {гъу} д {дж} {дз} {дзу} е ё ж {жъ} {жъу} {жь} з и й к {ку} {къ} {къу} {кӏ} {кӏу} л {лъ} {лӏ} м н о п {пӏ} {пӏу} р с т {тӏ} {тӏу} у ф х {хъ} {хъу} {хь} ц {цу} {цӏ} ч {чъ} {чӏ} ш {шъ} {шъу} {шӏ} {шӏу} щ ъ ы ь э ю я ӏ {ӏу}",
  "exemplar_auxiliary": "{гь} {кь} {кӏь}",
  "exemplar_syntax": "Unicode CLDR exemplar notation: a space separates letters; braces group the characters of a multi-character letter.",
  "letter_count": 66,
  "auxiliary_count": 3,
  "characters_of_note": {
    "palochka_upper": "Ӏ",
    "palochka_lower": "ӏ",
    "note": "U+04C0 and U+04CF. Never the Latin capital I (U+0049), the Latin small l (U+006C) or the digit 1 (U+0031)."
  },
  "rules": {
    "order": "Alphabetical order is given by \"alphabet_index\". Do not sort by codepoint: ё is U+0451 and would fall after я.",
    "matching": "When matching letters in running text, sort the entries by the length of \"cyrl_lower\", longest first. The array is in alphabetical order and must not be applied in that order.",
    "case": "\"cyrl_title\" uppercases the first character only; \"cyrl_upper\" uppercases every character. For multi-character letters these are different strings (кӏ -> Кӏ / КӀ). Do not derive one from the other at runtime.",
    "auxiliary": "Letters that occur in real material but are not part of the official Adyghe alphabet. They are kept out of \"main\" and carry no position in the alphabetical order. The \"dialect\" field records where each one is used.",
    "characters": "\"characters\" is derived from the single-character entries of \"main\". Use it to test whether a character belongs to the alphabet; use \"main\" for anything letter-based."
  },
